{
  "name": "dbpeek",
  "version": "0.1.0",
  "description": "Connect to any database and explore it in your browser. One command, nothing to install.",
  "type": "module",
  "license": "MIT",
  "author": "Alvin Quach",
  "repository": {
    "type": "git",
    "url": "https://github.com/alvinwquach/dbpeek"
  },
  "bin": {
    "dbpeek": "dist/cli/index.js"
  },
  "main": "dist/server/index.js",
  "types": "dist/server/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "build:client": "vite build",
    "build:all": "npm run build && npm run build:client",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.1",
    "@dagrejs/dagre": "^3.0.0",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.100.6",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "better-sqlite3": "^11.1.2",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "knex": "^3.1.0",
    "mysql2": "^3.10.0",
    "open": "^10.1.0",
    "papaparse": "^5.5.3",
    "pg": "^8.12.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "reactflow": "^11.11.4",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.2.4",
    "tedious": "^18.4.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^20.14.11",
    "eslint": "^9.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.3",
    "tsup": "^8.2.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^2.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
