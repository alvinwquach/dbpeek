{
  "name": "dbpeek",
  "version": "0.1.0",
  "description": "Connect to any database and explore it in your browser. One command, nothing to install.",
  "type": "module",
  "license": "MIT",
  "author": "Alvin Quach",
  "repository": {
    "type": "git",
    "url": "https://github.com/alvinwquach/dbpeek"
  },
  "bin": {
    "dbpeek": "dist/cli/index.js"
  },
  "main": "dist/server/index.js",
  "types": "dist/server/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "build:client": "vite build",
    "build:all": "npm run build && npm run build:client",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "express": "^4.19.2",
    "knex": "^3.1.0",
    "pg": "^8.12.0",
    "mysql2": "^3.10.0",
    "better-sqlite3": "^11.1.2",
    "tedious": "^18.4.0",
    "open": "^10.1.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "typescript": "^5.5.3",
    "tsup": "^8.2.4",
    "vite": "^5.3.4",
    "vitest": "^2.0.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.11",
    "@types/cors": "^2.8.17",
    "@types/better-sqlite3": "^7.6.11",
    "eslint": "^9.7.0",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
